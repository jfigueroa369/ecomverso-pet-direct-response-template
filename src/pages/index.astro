---
import Layout from '../layouts/Layout.astro';
import { manifest } from '../config/manifest';
---
<Layout title={manifest.name}>
  <div class="site-shell">
    <div class="ticker"><div class="ticker__track">{manifest.trust.map((item) => <span>✦ {item}</span>)}</div></div>
    <main>
      <section class="hero section-pad">
        <div class="hero__copy">
          <p class="eyebrow">{manifest.eyebrow}</p>
          <h1>{manifest.hero.headline} <em>{manifest.hero.highlight}</em></h1>
          <p class="lede">{manifest.hero.subheadline}</p>
          <div class="hero__actions"><button class="button button--primary" data-open-checkout>{manifest.hero.cta} <span>→</span></button><a class="text-link" href="#como-funciona">Conocer la rutina <span>↘</span></a></div>
          <div class="rating"><span class="avatars" aria-hidden="true"><i></i><i></i><i></i><b>+1k</b></span><strong>4.9 ★★★★★</strong><small>reseñas de familias con perros</small></div>
        </div>
        <figure class="hero__media"><img src={manifest.media.hero} alt="Perro junto a un frasco de suplemento" width="900" height="1125" fetchpriority="high" /><span class="media-tag">Paga en casa</span></figure>
      </section>
      <section class="trust-row">{manifest.trust.map((item) => <span><b>✓</b>{item}</span>)}</section>
      <section class="problem section-pad" id="problema"><div class="section-heading"><p class="eyebrow">Primero, lo que tú ves</p><h2>{manifest.problem.title}</h2><p>{manifest.problem.body}</p></div><div class="problem__grid"><ul>{manifest.problem.bullets.map((bullet) => <li><span>!</span>{bullet}</li>)}</ul><div class="problem__callout"><strong>Tu perro no debería acostumbrarse al malestar.</strong><span>Una rutina clara ayuda a tomar decisiones más sencillas.</span></div></div></section>
      <section class="evidence section-pad"><div class="section-heading"><p class="eyebrow">Una imagen, dos momentos</p><h2>La diferencia se entiende cuando la ves</h2></div><figure class="before-after"><img src={manifest.media.beforeAfter} alt="Comparación demostrativa de un perro antes y después de una rutina" width="900" height="1125" loading="lazy" /><figcaption><span>{manifest.beforeAfter.beforeLabel}</span><span>{manifest.beforeAfter.afterLabel}</span></figcaption></figure><p class="fineprint">{manifest.beforeAfter.caption}</p></section>
      <section class="mechanism section-pad" id="como-funciona"><div class="section-heading"><p class="eyebrow">Cómo se construye la rutina</p><h2>{manifest.mechanism.title}</h2><p>{manifest.mechanism.intro}</p></div><div class="steps">{manifest.mechanism.steps.map((step) => <article class="step"><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></article>)}</div></section>
      <section class="benefits section-pad"><div class="section-heading"><p class="eyebrow">Lo que cambia en el día a día</p><h2>Bienestar que cabe en un solo hábito</h2></div><div class="benefit-grid">{manifest.benefits.map((item) => <article><span class="benefit-number">{item.icon}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
      <section class="reviews section-pad"><div class="section-heading"><p class="eyebrow">Historias de compradores</p><h2>Cuando la rutina se vuelve más fácil</h2></div><div class="review-rail">{manifest.reviews.map((review) => <article class="review"><div class="review__top"><span class="review-avatar">{review.name.slice(0,1)}</span><div><strong>{review.name}</strong><small>{review.city} · Compra verificada</small></div><span class="stars">★★★★★</span></div><p>“{review.quote}”</p></article>)}</div></section>
      <section class="compare section-pad"><div class="section-heading"><p class="eyebrow">La decisión, sin ruido</p><h2>{manifest.comparison.title}</h2></div><div class="compare-card"><div class="compare-card__head"><span>Característica</span><strong>Esta rutina</strong><span>Alternativas</span></div>{manifest.comparison.rows.map((row) => <div class="compare-card__row"><span>{row.label}</span><strong>✓ {row.product}</strong><span>{row.alternative}</span></div>)}</div></section>
      <section class="offers section-pad" id="ofertas"><div class="section-heading"><p class="eyebrow">Elige la presentación</p><h2>Empieza hoy con la opción que encaja contigo</h2><p>El precio final, descuentos, moneda y disponibilidad los confirma el panel.</p></div><div class="offer-grid">{manifest.offers.map((offer) => <button class:list={['offer', offer.popular && 'offer--popular']} data-qty={offer.qty} data-open-checkout><span class="offer__qty">{offer.qty}×</span>{offer.badge && <small>{offer.badge}</small>}<strong>{offer.label}</strong><span>{offer.detail}</span><b>Ver precio disponible →</b></button>)}</div></section>
      <section class="faq section-pad"><div class="section-heading"><p class="eyebrow">Preguntas frecuentes</p><h2>Lo importante antes de pedir</h2></div><div class="faq-list">{manifest.faq.map((item) => <details><summary>{item.question}<span>+</span></summary><p>{item.answer}</p></details>)}</div></section>
    </main>
    <footer class="footer"><span>SILKROAD COMMERCE S.A.S.</span><span>NIT 902.088.592-9 · Bogotá D.C., Colombia</span><span><a href="/terminos">Términos</a> · <a href="/privacidad">Privacidad</a></span></footer>
  </div>
  <dialog class="checkout" id="checkout-dialog" aria-labelledby="checkout-title"><button class="checkout__close" type="button" data-close-checkout aria-label="Cerrar">×</button><div class="checkout__inner"><p class="eyebrow">Pedido seguro</p><h2 id="checkout-title">Completa tus datos</h2><p class="checkout__hint">La selección de oferta se valida en el panel antes de crear el pedido.</p><div class="checkout__offers">{manifest.offers.map((offer) => <button type="button" data-select-qty={offer.qty}><strong>{offer.label}</strong><span>{offer.detail}</span></button>)}</div><form id="order-form"><input type="hidden" name="quantity" value="1" /><label>Nombre completo<input name="fullName" required autocomplete="name" /></label><label>Celular<input name="phone" required autocomplete="tel" /></label><label>Departamento<input name="department" required /></label><label>Ciudad<input name="city" required /></label><label>Dirección<input name="address" required autocomplete="street-address" /></label><label class="optional">Correo (opcional)<input name="email" type="email" autocomplete="email" /></label><button class="button button--primary button--full" type="submit">SOLICITAR PEDIDO</button><p class="form-status" role="status"></p></form></div></dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#checkout-dialog');
    const form = document.querySelector<HTMLFormElement>('#order-form');
    const qty = document.querySelector<HTMLInputElement>('#order-form [name="quantity"]');
    const status = document.querySelector<HTMLElement>('#order-form .form-status');
    document.querySelectorAll<HTMLButtonElement>('[data-open-checkout]').forEach((button) => button.addEventListener('click', () => { if (button.dataset.qty && qty) qty.value = button.dataset.qty; dialog?.showModal(); }));
    document.querySelector<HTMLButtonElement>('[data-close-checkout]')?.addEventListener('click', () => (dialog as HTMLDialogElement | null)?.close());
    document.querySelectorAll<HTMLButtonElement>('[data-select-qty]').forEach((button) => button.addEventListener('click', () => { if (qty) qty.value = button.dataset.selectQty || '1'; document.querySelectorAll('[data-select-qty]').forEach((item) => item.classList.toggle('selected', item === button)); }));
    form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!qty || !status || !(form instanceof HTMLFormElement)) return; status.textContent = 'Enviando…'; const payload: Record<string, unknown> = Object.fromEntries(new FormData(form)); payload.quantity = Number(payload.quantity || 1); payload.paymentMethod = 'cod'; try { const response = await fetch('/api/order', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }); const data = await response.json(); if (!response.ok || !data.ok) throw new Error(data.error || 'No se pudo crear el pedido'); status.textContent = 'Pedido recibido. Te contactaremos para confirmar.'; form.reset(); } catch (error) { status.textContent = error instanceof Error ? error.message : 'No pudimos procesar tu pedido.'; } });
  </script>
</Layout>
