---
import Layout from '../layouts/Layout.astro';
import { manifest } from '../config/manifest';
---
<Layout title={manifest.name}>
  <div class="site-shell">
    <div class="ticker" role="status" aria-label="Avisos de compra">
      <div class="ticker__track">
        {[...manifest.trust, ...manifest.trust].map((item) => <span>✦ {item}</span>)}
      </div>
    </div>
    <div class="unit-counter" id="unit-counter" data-start={String(Number(import.meta.env.PUBLIC_STOCK_START || 27))}>
      <span class="unit-counter__dot" aria-hidden="true"></span>
      <span id="unit-counter-label">Oferta activa para esta presentación</span>
      <strong id="unit-counter-value">Calculando disponibilidad…</strong>
      <span class="unit-counter__timer" aria-label="Tiempo restante de la oferta"><span id="unit-counter-timer">15:00</span></span>
    </div>

    <main>
      <section class="hero section-pad">
        <div class="hero__copy">
          <p class="eyebrow">{manifest.eyebrow}</p>
          <h1>{manifest.hero.headline} <em>{manifest.hero.highlight}</em></h1>
          <p class="lede">{manifest.hero.subheadline}</p>
          <div class="hero__actions">
            <button class="button button--primary" data-open-checkout>{manifest.hero.cta} <span aria-hidden="true">↗</span></button>
            <a class="text-link" href="#galeria">Ver la rutina <span aria-hidden="true">↓</span></a>
          </div>
          <div class="rating" aria-label="Valoración 4.9 sobre 5">
            <span class="avatars" aria-hidden="true"><i></i><i></i><i></i><b>+1k</b></span>
            <strong>4.9 <span class="stars">★★★★★</span></strong>
            <small>familias que ya la sumaron a su día</small>
          </div>
        </div>
        <div class="hero__visual">
          <figure class="hero__media"><img src={manifest.media.hero} alt="Perro junto a una presentación de bocados de bienestar" width="900" height="1125" fetchpriority="high" /><span class="media-tag">Paga en casa</span></figure>
          <div class="hero__stamp"><span>01</span><b>Un hábito<br />que se disfruta</b></div>
        </div>
      </section>

      <section class="proof-strip" aria-label="Puntos de confianza">
        <div><b>01</b><span>Envío según cobertura</span></div><div><b>02</b><span>Pago contraentrega cuando aplica</span></div><div><b>03</b><span>Compra protegida</span></div><div><b>04</b><span>Atención para resolver dudas</span></div>
      </section>

      <section class="manifesto section-pad"><div class="manifesto__mark">/ una historia<br />para su bienestar</div><div class="manifesto__copy"><p class="eyebrow">Empieza por lo que ves</p><h2>Su día habla.<br /><em>Escúchalo.</em></h2><p>Cuando una mascota cambia su forma de comer, jugar o descansar, toda la casa lo siente. Esta plantilla convierte esa observación en una ruta clara para elegir, entender y acompañar.</p></div><div class="manifesto__aside"><span>La decisión</span><strong>no debería<br />ser complicada</strong><i>↘</i></div></section>

      <section class="problem section-pad" id="problema"><div class="section-heading"><p class="eyebrow">Lo que puede estar pasando</p><h2>{manifest.problem.title}</h2><p>{manifest.problem.body}</p></div><div class="problem__grid"><ul>{manifest.problem.bullets.map((bullet, index) => <li><span>0{index + 1}</span><b>{bullet}</b><i>↗</i></li>)}</ul><figure class="problem__photo"><img src={manifest.gallery[1].src} alt={manifest.gallery[1].alt} loading="lazy" width="900" height="1125" /><figcaption>{manifest.gallery[1].label}<small>{manifest.gallery[1].note}</small></figcaption></figure></div></section>

      <section class="evidence section-pad"><div class="evidence__header section-heading"><p class="eyebrow">Antes / después</p><h2>La diferencia se entiende cuando la ves</h2><p>Un bloque visual para explicar el cambio esperado sin esconder el producto ni llenar la pantalla de promesas.</p></div><figure class="before-after"><img src={manifest.media.beforeAfter} alt="Comparación demostrativa de un perro antes y después de una rutina" width="900" height="1125" loading="lazy" /><figcaption><span>{manifest.beforeAfter.beforeLabel}</span><span>{manifest.beforeAfter.afterLabel}</span></figcaption></figure><p class="fineprint">{manifest.beforeAfter.caption}</p></section>

      <section class="mechanism section-pad" id="como-funciona"><div class="section-heading"><p class="eyebrow">Cómo se construye la rutina</p><h2>{manifest.mechanism.title}</h2><p>{manifest.mechanism.intro}</p></div><div class="steps">{manifest.mechanism.steps.map((step) => <article class="step"><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p><i aria-hidden="true">↗</i></article>)}</div></section>

      <section class="gallery section-pad" id="galeria"><div class="gallery__intro"><p class="eyebrow">Mírala de cerca</p><h2>Una rutina real se ve así</h2><p>Galería modular para que cada producto pueda enseñar su textura, su momento y la forma en que entra a una casa.</p></div><div class="gallery__grid">{manifest.gallery.map((item, index) => <figure class:list={['gallery-card', `gallery-card--${index + 1}`]}><img src={item.src} alt={item.alt} loading="lazy" width="900" height="1125" /><figcaption><b>{item.label}</b><span>{item.note}</span></figcaption></figure>)}</div></section>

      <section class="benefits section-pad"><div class="benefits__top"><div><p class="eyebrow">Lo que cambia en el día a día</p><h2>Bienestar que cabe en un solo hábito</h2></div><span class="benefits__line">/ pequeño para ti<br />importante para él</span></div><div class="benefit-list">{manifest.benefits.map((item, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.body}</p></div><b>{item.icon}</b></article>)}</div></section>

      <section class="reviews section-pad"><div class="section-heading"><p class="eyebrow">Historias de compradores</p><h2>Cuando la rutina se vuelve más fácil</h2></div><div class="review-feature"><div class="review-feature__quote">“</div><blockquote>{manifest.reviews[0].quote}</blockquote><div class="review-feature__person"><span class="review-avatar">{manifest.reviews[0].name.slice(0, 1)}</span><span><b>{manifest.reviews[0].name}</b><small>{manifest.reviews[0].city} · Compra verificada</small></span><strong>★★★★★</strong></div></div><div class="review-rail">{manifest.reviews.slice(1).map((review) => <article class="review"><div class="review__top"><span class="review-avatar">{review.name.slice(0, 1)}</span><div><strong>{review.name}</strong><small>{review.city} · Compra verificada</small></div><span class="stars">★★★★★</span></div><p>“{review.quote}”</p></article>)}</div></section>

      <section class="compare section-pad"><div class="section-heading"><p class="eyebrow">La decisión, sin ruido</p><h2>{manifest.comparison.title}</h2></div><div class="compare-card"><div class="compare-card__head"><span>En qué fijarte</span><strong>Esta rutina</strong><span>Otras opciones</span></div>{manifest.comparison.rows.map((row, index) => <div class="compare-card__row"><span><b>0{index + 1}</b>{row.label}</span><strong>✓ {row.product}</strong><span>{row.alternative}</span></div>)}</div></section>

      <section class="offers section-pad" id="ofertas"><div class="offers__inner"><div class="section-heading"><p class="eyebrow">Elige la presentación</p><h2>Empieza hoy con la opción que encaja contigo</h2><p>El precio final, descuentos, moneda y disponibilidad los confirma el panel.</p></div><div class="offer-grid">{manifest.offers.map((offer, index) => <button class:list={['offer', offer.popular && 'offer--popular']} data-qty={offer.qty} data-open-checkout><span class="offer__index">0{index + 1}</span><span class="offer__qty">{offer.qty}×</span>{offer.badge && <small>{offer.badge}</small>}<strong>{offer.label}</strong><span>{offer.detail}</span><b>Ver precio disponible <i>↗</i></b></button>)}</div></div></section>

      <section class="faq section-pad"><div class="section-heading"><p class="eyebrow">Preguntas frecuentes</p><h2>Lo importante antes de pedir</h2></div><div class="faq-list">{manifest.faq.map((item, index) => <details><summary><span>0{index + 1}</span>{item.question}<b>+</b></summary><p>{item.answer}</p></details>)}</div></section>
      <section class="final-cta section-pad"><p class="eyebrow">Hazlo sencillo</p><h2>Una mejor rutina<br /><em>empieza hoy.</em></h2><button class="button button--light" data-open-checkout>{manifest.hero.cta} <span aria-hidden="true">↗</span></button></section>
    </main>

    <footer class="footer"><div><b>SILKROAD COMMERCE S.A.S.</b><span>NIT 902.088.592-9 · Bogotá D.C., Colombia</span></div><span><a href="/terminos">Términos</a> · <a href="/privacidad">Privacidad</a></span></footer><div class="mobile-dock"><span><b>Oferta activa</b><small>Precio confirmado en checkout</small></span><button class="button button--primary" data-open-checkout>Quiero la mía ↗</button></div>
  </div>

  <dialog class="checkout" id="checkout-dialog" aria-labelledby="checkout-title"><button class="checkout__close" type="button" data-close-checkout aria-label="Cerrar">×</button><div class="checkout__inner"><img class="checkout__trust" src="/checkout-assets/banner-garantia.webp" alt="Envío gratis y paga seguro al recibir" width="1080" height="667" /><p class="eyebrow">Pedido seguro</p><h2 id="checkout-title">Completa tus datos</h2><p class="checkout__hint">La oferta y el precio se validan en el panel antes de crear el pedido.</p><div class="checkout__offers">{manifest.offers.map((offer) => <button type="button" data-select-qty={offer.qty}><strong>{offer.label}</strong><span>{offer.detail}</span></button>)}</div><form id="order-form"><input type="hidden" name="quantity" value="1" /><label>Nombre completo<input name="fullName" required autocomplete="name" /></label><label>Celular<input name="phone" required autocomplete="tel" /></label><label>Departamento<input name="department" required /></label><label>Ciudad<input name="city" required /></label><label>Dirección<input name="address" required autocomplete="street-address" /></label><label class="optional">Correo (opcional)<input name="email" type="email" autocomplete="email" /></label><button class="button button--primary button--full" type="submit">SOLICITAR PEDIDO</button><img class="checkout__payment" src="/checkout-assets/banner-pago.webp" alt="Medios de pago disponibles" width="1080" height="667" /><p class="form-status" role="status"></p></form></div></dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#checkout-dialog');
    const form = document.querySelector<HTMLFormElement>('#order-form');
    const qty = document.querySelector<HTMLInputElement>('#order-form [name="quantity"]');
    const status = document.querySelector<HTMLElement>('#order-form .form-status');
    document.querySelectorAll<HTMLButtonElement>('[data-open-checkout]').forEach((button) => button.addEventListener('click', () => { if (button.dataset.qty && qty) qty.value = button.dataset.qty; dialog?.showModal(); }));
    document.querySelector<HTMLButtonElement>('[data-close-checkout]')?.addEventListener('click', () => dialog?.close());
    document.querySelectorAll<HTMLButtonElement>('[data-select-qty]').forEach((button) => button.addEventListener('click', () => { if (qty) qty.value = button.dataset.selectQty || '1'; document.querySelectorAll('[data-select-qty]').forEach((item) => item.classList.toggle('selected', item === button)); }));
    const counter = document.querySelector<HTMLElement>('#unit-counter'); const counterValue = document.querySelector<HTMLElement>('#unit-counter-value'); const timer = document.querySelector<HTMLElement>('#unit-counter-timer');
    if (counter && counterValue && timer) { const start = Number(counter.dataset.start || 27); const stockKey = `pdr-stock-${location.pathname}`; const deadlineKey = `pdr-deadline-${location.pathname}`; let stock = Number(sessionStorage.getItem(stockKey) || start); let deadline = Number(sessionStorage.getItem(deadlineKey) || 0); if (!deadline || deadline < Date.now()) { deadline = Date.now() + 15 * 60 * 1000; sessionStorage.setItem(deadlineKey, String(deadline)); } const render = () => { counterValue.textContent = `Quedan ${stock} unidades a este precio`; const diff = Math.max(0, Math.floor((deadline - Date.now()) / 1000)); timer.textContent = `${String(Math.floor(diff / 60)).padStart(2, '0')}:${String(diff % 60).padStart(2, '0')}`; }; render(); window.setInterval(render, 1000); window.setInterval(() => { if (stock > 4 && Math.random() > .45) { stock -= 1; sessionStorage.setItem(stockKey, String(stock)); render(); } }, 18000); }
    form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!qty || !status || !(form instanceof HTMLFormElement)) return; status.textContent = 'Enviando…'; const payload: Record<string, unknown> = Object.fromEntries(new FormData(form)); payload.quantity = Number(payload.quantity || 1); payload.paymentMethod = 'cod'; try { const response = await fetch('/api/order', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }); const data = await response.json(); if (!response.ok || !data.ok) throw new Error(data.error || 'No se pudo crear el pedido'); status.textContent = 'Pedido recibido. Te contactaremos para confirmar.'; form.reset(); } catch (error) { status.textContent = error instanceof Error ? error.message : 'No pudimos procesar tu pedido.'; } });
  </script>
</Layout>
